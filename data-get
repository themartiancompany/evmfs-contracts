function
  _contract_name_check(
    _contract_name) {
  let
    _contract_name_get,
    _msg;
  const
    _contract_name_type =
      typeof(
        _contract_name);
  const
    _default =
      "FileSystem";
  _contract_name_get =
    false;
  if ( _contract_name_type === "undefined" ) {
    _msg =
      "Contract name undefined, setting " +
      `default, '${_default}'.`;
    _msg_info(
      _msg);
    _contract_name_get =
      true;
  }
  else if ( _contract_name_type === "string" ) {
    if ( _contract_name.length < 1 ) {
      _msg =
        "Contract name not specified, setting " +
        `default, '${_default}'.`;
      _msg_info(
        _msg);
      _contract_name_get =
        true;
    }
  }
  else if ( _contract_name_type === "number" ||
            _contract_name_type === "bigint" ) {
    true;
  else {
    _msg =
      `Unknown type '${_contract_name_type}' for ` +
      `variable '_contract_name'.`;
    _msg_error(
      _msg,
      0);
    throw _msg;
  }
  if ( _contract_name_get ) {
    _contract_name =
      _default;
  }
  return _contract_name;
}

